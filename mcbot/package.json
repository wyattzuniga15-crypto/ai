{
  "name": "minecraft-ai-player",
  "version": "1.0.0",
  "description": "An AI that joins a Minecraft server as a real player: equips the right tools, mines what it is told to, and fights hostile mobs.",
  "main": "index.js",
  "bin": {
    "minecraft-ai-player": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.js",
    "test:all": "npm test && npm run test:e2e",
    "lint": "standard index.js src/ test/",
    "lint:fix": "standard --fix index.js src/ test/"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "minecraft-data": "^3.116.0",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "flying-squid": "^1.12.0",
    "standard": "^17.1.2"
  }
}
