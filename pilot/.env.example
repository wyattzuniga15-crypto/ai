# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# claude-sonnet-5 (default, cheaper/faster) or claude-opus-5 (smarter)
PILOT_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max - how hard the model thinks per step
PILOT_EFFORT=high
# adaptive | off
PILOT_THINKING=adaptive

PILOT_MAX_STEPS=40
PILOT_ACTION_DELAY=0.3
PILOT_SCREENSHOTS_IN_CONTEXT=3

# Screenshot size sent to the model. Bigger reads small text better but costs more.
PILOT_MAX_WIDTH=1280
PILOT_MAX_HEIGHT=800
# 1 = primary monitor, 0 = every monitor as one image
PILOT_MONITOR=1

PILOT_KILL_KEY=f12
PILOT_FAILSAFE=yes
PILOT_CONFIRM_RISKY=yes
PILOT_CONFIRM_EVERY_ACTION=no
